# Data (large / generated) — fixtures and results are NOT ignored (see below)
data/raw/
data/processed/
runs/
logs/

# Secrets
.env
kaggle.json

# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Model / scaler artifacts
*.pt
*.pkl
*.joblib

# Explicitly tracked (negations must come after the ignores above)
!data/fixtures/

# Raw dataset archives (multi-GB) and stray captures - never commit
*.zip
*.parquet
/botnet_ares.csv

# SOC runtime state (alerts, settings with tokens), user uploads
artifacts/soc/
data/inbox/
data/user_datasets/
data/samples/

# Generated by the AI-engineer run (rebuilt on every machine)
results/
artifacts/
datasets/
*.tmp
.tmp/
.pip-cache/

deploy_siem/.env
tools/sysmon/

# local control marker: blocks self-improvement auto-commits (owner 2026-10-14)
.no_autocommit

# Datasets kept out of git (owner 2026-10-16): blind sets and attack-data dev copies
data/blind/
data/attack_data_dev/

# OWASP CRS rules: fetched by the update agent / installer (Windows Defender flags them;
# exclude this folder in Windows Security to use CRS)
third_party/coreruleset/rules/
third_party/coreruleset/.staging*/
third_party/coreruleset/.previous/

# Claude Code settings and worktrees (local only)
.claude/
