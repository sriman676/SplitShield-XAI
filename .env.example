# Copy to .env and fill in. Never commit a real .env.
# All values here are speed/placement only — they NEVER affect computed numbers
# (07_COMPUTE.md §1) and are excluded from the config hash.

# Force a compute tier for testing fallback paths: dedicated_gpu | igpu | cpu_only
COMPUTE_TIER_OVERRIDE=

# Dataloader / device tuning (excluded from config hash)
NUM_WORKERS=0
PIN_MEMORY=false
LOG_LEVEL=INFO

# Kaggle credentials for dataset download (Task 1). Prefer ~/.kaggle/kaggle.json.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
